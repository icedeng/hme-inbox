# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，绝不要提交。

# ── IMAP（仅 worker 需要）────────────────────────────────────
# App 专用密码在 appleid.apple.com 生成，不是 Apple ID 主密码。
# 注意：修改 Apple ID 主密码会一次性吊销全部 App 专用密码。
HME_IMAP_HOST=imap.mail.me.com
HME_IMAP_PORT=993
HME_IMAP_USER=you@icloud.com
HME_IMAP_PASS=xxxx-xxxx-xxxx-xxxx

# 要盯的邮箱，逗号分隔。
# 验证码邮件来自陌生发件人，被判进 Junk 是常态，只盯 INBOX 会静默漏信。
# imapflow 一条连接只能锁一个邮箱，所以每多一个就多一条 IMAP 连接。
HME_IMAP_MAILBOXES=INBOX,Junk

# 首次创建账号时的收信起点，留空则从当前时间开始（只收新信）。
# 只在账号首次创建时生效 —— 之后改它不会有任何作用，
# 否则每次重启都会把起点推到当下，漏掉停机期间的信。
# HME_SYNC_SINCE=2026-08-01T00:00:00Z

# ── 存储（三个容器共用）──────────────────────────────────────
DATABASE_PATH=./data/hme.db
ATTACHMENT_DIR=./data/attachments
TZ=UTC

# ── Web ─────────────────────────────────────────────────────
#
# ⚠️ 本文件里的值**不要包含 $ 字符**。
# 处理 .env 的工具普遍会做变量展开（Next.js 用 dotenv-expand、
# Docker Compose 自己也插值 $VAR），值里的 $xxx 会被静默替换成空串。
# 密码哈希因此刻意用 : 而不是惯例的 $ 做分隔符。
# 如果你的 IMAP 密码含 $，请用单引号包裹：HME_IMAP_PASS='a$b'
#
# scrypt 哈希，用 `npm run hash-password -- '你的密码'` 生成。
# 明文密码不进环境变量 —— 它会出现在 docker inspect 与进程列表里。
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32
SESSION_SECRET=
# 对外基址，用于拼取件 URL，末尾不带斜杠
PUBLIC_BASE_URL=https://api.example.com
SESSION_TTL_HOURS=72
# 只有 Web 不能被外部直接访问、且前置代理会重写转发头时才设为 true。
TRUST_PROXY_HEADERS=false
# Chrome 扩展推送新隐藏邮箱使用；留空则 /api/aliases 返回 503。
# openssl rand -hex 32
HME_PUSH_TOKEN=
# turb-gpt-free-register 通用 API 邮箱池；任一项留空则管理页推送功能禁用。
TURB_GPT_BASE_URL=http://192.168.0.250:5050
TURB_GPT_AUTH_CODE=

# ── Token 加密（web + worker 都要，且必须一致）───────────────
# openssl rand -base64 32
# 丢失此密钥 = 全部取件 URL 需批量轮换重发，请单独备份。
TOKEN_ENC_KEY=

# ── 保留与抓取策略 ───────────────────────────────────────────
RETENTION_DAYS=30
UNMATCHED_RETENTION_DAYS=60
ACCESS_LOG_RETENTION_DAYS=7
POLL_INTERVAL_MS=60000
# IDLE 主动刷新周期。RFC 2177 建议不超过 29 分钟，默认 25 分钟。
IDLE_REFRESH_MS=1500000
MAX_MESSAGE_BYTES=5242880
MAX_INLINE_ATTACHMENT_BYTES=262144
MAX_FILE_ATTACHMENT_BYTES=10485760
FETCH_BATCH_SIZE=200

# ── 归属规则覆盖（苹果改了转发实现时用）─────────────────────
# 在「未归属」页看到某个陌生头名反复出现，把它加进来即可恢复归属，
# 不需要改代码、不需要发版。
# HME_MATCH_EXTRA_HEADERS=X-Apple-Some-New-Header
# 关闭正文扫描（误报风险最高的一层）
# HME_MATCH_BODY_SCAN=0

# LOG_LEVEL=info
